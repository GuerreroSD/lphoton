{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LPhoton",
  "version": "0.5.0",
  "identifier": "cl.ucm.lphoton",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LPhoton",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#2D1B36"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://cover.localhost cover:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "GuerreroSD",
    "shortDescription": "Launcher liviano que unifica Steam, Epic Games y GOG",
    "longDescription": "LPhoton une tus bibliotecas de Steam, Epic Games y GOG, sin publicidad y con bajo consumo de recursos.",
    "category": "Game",
    "copyright": "Luis Barrios Urbina y Alan Troncoso Jara",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}